# ─────────────────────────────────────────────
# 셰르피 환경변수 — 이 파일을 .env.local 로 복사해서 채우세요
# .env.local 은 절대 깃에 올리지 마세요
# ─────────────────────────────────────────────

# Neon Postgres (https://console.neon.tech)
DATABASE_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/sherpy?sslmode=require"

# 세션 서명 키 — 아무 긴 랜덤 문자열
SESSION_SECRET="change-me-to-a-long-random-string"

# 카카오맵 JavaScript 키 (https://developers.kakao.com)
NEXT_PUBLIC_KAKAO_MAP_KEY=""

# 공공데이터포털 서비스키 (Decoding 키)
# 기상청 단기예보: https://www.data.go.kr/data/15084084/openapi.do
# 에어코리아 대기오염정보: 공공데이터포털에서 별도 신청
DATA_GO_KR_SERVICE_KEY=""

# 로봇 영상 (MediaMTX + Cloudflare Tunnel 주소)
# 예: https://sherpy-cam.trycloudflare.com
NEXT_PUBLIC_ROBOT_STREAM_BASE=""

# 개발용 모의 로봇이 사용할 값 (scripts/mock-robot.ts)
MOCK_ROBOT_ID="1"
MOCK_ROBOT_API_KEY="dev-robot-key-change-me"
MOCK_SERVER_URL="http://localhost:3000"

# 로봇 연동 모드 — 실로봇(라즈베리파이 bridge)이 텔레메트리를 올리기 시작하면 live 로 바꾸세요.
# 비워두면 앱은 브라우저 안의 가상 셰르피로 시연합니다.
ROBOT_MODE=""

# 어드민(/admin) 비밀번호 — 비워두면 어드민이 잠깁니다
ADMIN_PASSWORD=""
